<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.form (in eng_sale_customer_order_ref)</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <group name="partner_details" position="inside">
                <field name="client_order_ref" position="move" />
            </group>
            <!-- The form of a line not saved yet only shows what the list
                 has loaded: without the field here, it opens empty. -->
            <xpath
                expr="//field[@name='order_line']/tree/field[@name='name']"
                position="after"
            >
                <field name="partner_order" optional="hide" />
            </xpath>
        </field>
    </record>
</odoo>
