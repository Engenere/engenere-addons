<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_picking_form" model="ir.ui.view">
        <field name="name">stock.picking.form.readonly.sales.purchase</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_cancel']" position="attributes">
                <attribute name="groups">stock.group_stock_user</attribute>
            </xpath>
            <xpath expr="//button[@name='button_scrap']" position="attributes">
                <attribute name="groups">stock.group_stock_user</attribute>
            </xpath>
            <xpath expr="//button[@name='do_unreserve']" position="attributes">
                <attribute name="groups">stock.group_stock_user</attribute>
            </xpath>
            <xpath
                expr="//button[@name='%(stock.act_stock_return_picking)d']"
                position="attributes"
            >
                <attribute name="groups">stock.group_stock_user</attribute>
            </xpath>
        </field>
    </record>

    <record id="vpicktree" model="ir.ui.view">
        <field name="name">stock.picking.tree.readonly.sales.purchase</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree" />
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='do_unreserve']" position="attributes">
                <attribute name="groups">stock.group_stock_user</attribute>
            </xpath>
        </field>
    </record>

</odoo>
