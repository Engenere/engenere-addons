<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!--
        The Delivery smart button on the sale order is gated by
        stock.group_stock_user upstream. Salespeople need to reach the
        related transfers in read-only, so widen the button to the sales
        roles as well. Write actions on the picking stay blocked by the
        lockdown ACL.
    -->
    <record id="view_order_form_delivery_button_sales" model="ir.ui.view">
        <field name="name">sale.order.form.delivery.button.sales</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_stock.view_order_form_inherit_sale_stock" />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_view_delivery']" position="attributes">
                <attribute
                    name="groups"
                >stock.group_stock_user,sales_team.group_sale_salesman</attribute>
            </xpath>
        </field>
    </record>

</odoo>
