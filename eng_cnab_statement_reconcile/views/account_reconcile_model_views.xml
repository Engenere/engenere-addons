<odoo>

    <record id="view_account_reconcile_model_form_cnab" model="ir.ui.view">
        <field name="name">account.reconcile.model.form.eng.cnab</field>
        <field name="model">account.reconcile.model</field>
        <field name="inherit_id" ref="account.view_account_reconcile_model_form" />
        <field name="arch" type="xml">
            <field name="matching_order" position="after">
                <field
                    name="eng_cnab_clearing_match"
                    attrs="{'invisible': [('rule_type', '!=', 'invoice_matching')]}"
                />
                <field
                    name="eng_receiving_bank_filter"
                    attrs="{'invisible': ['|', ('rule_type', '!=', 'invoice_matching'), ('eng_cnab_clearing_match', '=', False)]}"
                />
            </field>
        </field>
    </record>

</odoo>
