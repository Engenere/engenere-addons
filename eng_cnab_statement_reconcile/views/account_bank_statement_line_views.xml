<odoo>

    <!-- Reconciliation screen: reason and retry of a pending collection credit -->
    <record id="bank_statement_line_form_reconcile_view_cnab" model="ir.ui.view">
        <field name="name">account.bank.statement.line.reconcile.eng.cnab</field>
        <field name="model">account.bank.statement.line</field>
        <field
            name="inherit_id"
            ref="account_reconcile_oca.bank_statement_line_form_reconcile_view"
        />
        <field name="arch" type="xml">
            <button name="clean_reconcile" position="after">
                <button
                    name="action_eng_cnab_retry"
                    type="object"
                    string="Retry CNAB Matching"
                    class="btn btn-secondary"
                    groups="account.group_account_user"
                    attrs="{'invisible': ['|', ('is_reconciled', '=', True), ('eng_cnab_reconcile_status', '=', False)]}"
                />
            </button>
            <notebook position="before">
                <field name="eng_cnab_reconcile_status" invisible="1" />
                <div
                    class="alert alert-warning mb-2"
                    role="alert"
                    attrs="{'invisible': ['|', ('is_reconciled', '=', True), ('eng_cnab_reconcile_status', 'not in', ('awaiting', 'difference', 'partial', 'ambiguous', 'invalid_config', 'excluded', 'error'))]}"
                >
                    <field name="eng_cnab_reconcile_message" nolabel="1" />
                </div>
            </notebook>
        </field>
    </record>

    <record id="bank_statement_line_reconcile_view_cnab" model="ir.ui.view">
        <field name="name">account.bank.statement.line.reconcile.kanban.eng.cnab</field>
        <field name="model">account.bank.statement.line</field>
        <field
            name="inherit_id"
            ref="account_reconcile_oca.bank_statement_line_reconcile_view"
        />
        <field name="arch" type="xml">
            <field name="to_check" position="after">
                <field name="eng_cnab_reconcile_status" />
            </field>
            <xpath
                expr="//div[@t-if='record.is_reconciled.raw_value']"
                position="after"
            >
                <div
                    t-if="record.eng_cnab_reconcile_status.raw_value and !record.is_reconciled.raw_value"
                    class="badge text-bg-info"
                >
                    <field name="eng_cnab_reconcile_status" />
                </div>
            </xpath>
        </field>
    </record>

    <record id="account_bank_statement_line_tree_cnab" model="ir.ui.view">
        <field name="name">account.bank.statement.line.tree.eng.cnab</field>
        <field name="model">account.bank.statement.line</field>
        <field
            name="inherit_id"
            ref="account_statement_base.account_bank_statement_line_tree"
        />
        <field name="arch" type="xml">
            <field name="running_balance" position="after">
                <field name="eng_cnab_reconcile_status" optional="show" />
                <button
                    name="action_eng_cnab_retry"
                    type="object"
                    title="Retry CNAB Matching"
                    icon="fa-refresh"
                    groups="account.group_account_user"
                    attrs="{'invisible': ['|', ('is_reconciled', '=', True), ('eng_cnab_reconcile_status', '=', False)]}"
                />
            </field>
        </field>
    </record>

    <record id="account_bank_statement_line_search_cnab" model="ir.ui.view">
        <field name="name">account.bank.statement.line.search.eng.cnab</field>
        <field name="model">account.bank.statement.line</field>
        <field
            name="inherit_id"
            ref="account_statement_base.account_bank_statement_line_search"
        />
        <field name="arch" type="xml">
            <filter name="to_check" position="after">
                <separator />
                <filter
                    name="eng_cnab_pending"
                    string="CNAB Pending"
                    domain="[('is_reconciled', '=', False), ('eng_cnab_reconcile_status', 'in', ('awaiting', 'difference', 'partial', 'ambiguous', 'invalid_config', 'excluded', 'error'))]"
                />
            </filter>
            <field name="journal_id" position="after">
                <field name="eng_cnab_reconcile_status" />
            </field>
        </field>
    </record>

</odoo>
