#. module: eng_cnab_statement_reconcile
#. odoo-python
#: code:addons/eng_cnab_statement_reconcile/models/account_bank_statement_line.py:0
#, python-format
msgid ""
"Awaiting the CNAB return: no open CNAB clearing line of %(account)s due on "
"%(date)s matches the rule %(rule)s yet."
msgstr ""
"Aguardando o retorno CNAB: ainda não há linha em aberto da transitória CNAB "
"%(account)s com vencimento em %(date)s que atenda à regra %(rule)s."

