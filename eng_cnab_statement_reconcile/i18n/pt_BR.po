#. module: eng_cnab_statement_reconcile
#: model:ir.model.fields,help:eng_cnab_statement_reconcile.field_account_reconcile_model__eng_receiving_bank_filter
msgid ""
"CNAB clearing lines of the group, by the bank where the customer paid: any "
"bank, the bank of the journal only, or the other banks only. Use the last "
"two when the bank statement splits the collection credit of a day by "
"receiving bank."
msgstr ""
"Linhas da transitória CNAB que entram no grupo, pelo banco onde o cliente "
"pagou: qualquer banco, só o banco do diário ou só os outros bancos. Use as "
"duas últimas quando o extrato separa o crédito de cobrança de um dia por "
"banco recebedor."

#. module: eng_cnab_statement_reconcile
#: model:ir.model.fields.selection,name:eng_cnab_statement_reconcile.selection__account_bank_statement_line__eng_cnab_reconcile_status__error
msgid "Error"
msgstr "Erro"

#. module: eng_cnab_statement_reconcile
#. odoo-python
#: code:addons/eng_cnab_statement_reconcile/models/account_bank_statement_line.py:0
#, python-format
msgid ""
"Error: the CNAB matching of this line failed, and the scheduled action went on with the other lines. Fix the cause, then retry.\n"
"%(error)s"
msgstr ""
"Erro: a conciliação CNAB desta linha falhou, e a ação agendada seguiu com as outras linhas. Corrija a causa e tente de novo.\n"
"%(error)s"

#. module: eng_cnab_statement_reconcile
#: model:ir.model,name:eng_cnab_statement_reconcile.model_account_statement_import
