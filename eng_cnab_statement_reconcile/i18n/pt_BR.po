#. module: eng_cnab_statement_reconcile
#: model:ir.model.fields.selection,name:eng_cnab_statement_reconcile.selection__account_bank_statement_line__eng_cnab_reconcile_status__ambiguous
msgid "Ambiguous"
msgstr "Ambígua"

#. module: eng_cnab_statement_reconcile
#. odoo-python
#: code:addons/eng_cnab_statement_reconcile/models/account_bank_statement_line.py:0
#, python-format
msgid ""
"Ambiguous: %(others)s other open statement lines of the journal on %(date)s "
"(%(lines)s) also meet the conditions of the rule %(rule)s, so its CNAB "
"clearing lines are not assigned automatically. Review them on the "
"reconciliation screen."
msgstr ""
"Ambígua: a regra %(rule)s também atende a linhas de extrato em aberto do "
"diário em %(date)s (quantidade: %(others)s; linhas: %(lines)s), por isso as "
"linhas da transitória CNAB não são atribuídas automaticamente. Revise na "
"tela de conciliação."

#. module: eng_cnab_statement_reconcile
#. odoo-python
#: code:addons/eng_cnab_statement_reconcile/models/account_bank_statement_line.py:0
#, python-format
msgid ""
"Ambiguous: the rules %(rules)s each match a different group of open CNAB "
"clearing lines of %(account)s due on %(date)s that sums exactly the amount "
"of the statement line, so none of them is reconciled automatically. Review "
"them on the reconciliation screen."
msgstr ""
"Ambígua: as regras %(rules)s casam, cada uma, um grupo diferente de linhas "
"em aberto da transitória CNAB %(account)s com vencimento em %(date)s que "
"soma exatamente o valor da linha do extrato, por isso nenhum deles é "
"conciliado automaticamente. Revise-os na tela de conciliação."

#. module: eng_cnab_statement_reconcile
#: model:ir.model.fields.selection,name:eng_cnab_statement_reconcile.selection__account_bank_statement_line__eng_cnab_reconcile_status__difference
msgid "Amount Difference"
msgstr "Diferença de valor"

#. module: eng_cnab_statement_reconcile
#. odoo-python
#: code:addons/eng_cnab_statement_reconcile/models/account_bank_statement_line.py:0
#, python-format
msgid ""
"Amount difference of %(difference)s: the statement line amount is "
"%(amount)s, and the %(count)s open CNAB clearing lines of %(account)s due on"
" %(date)s for the rule %(rule)s sum %(total)s. Nothing was reconciled: "
"review it on the reconciliation screen."
msgstr ""
"Diferença de valor de %(difference)s: a linha do extrato vale %(amount)s, e "
"o grupo de linhas em aberto da transitória CNAB %(account)s com vencimento "
"em %(date)s pela regra %(rule)s soma %(total)s (quantidade de linhas: "
"%(count)s). Nada foi conciliado: revise na tela de conciliação."

#. module: eng_cnab_statement_reconcile
#: model:ir.model.fields,help:eng_cnab_statement_reconcile.field_account_bank_statement_line__eng_cnab_reconcile_difference
msgid ""
"Amount of the statement line minus the sum of its group of CNAB clearing "
"lines, when they differ."
msgstr ""
"Valor da linha do extrato menos a soma do seu grupo de linhas da transitória"
" CNAB, quando são diferentes."

