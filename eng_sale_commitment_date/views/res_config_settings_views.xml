<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
            name="name"
        >res.config.settings.form (in eng_sale_commitment_date)</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@id='quotation_validity_days']" position="after">
                <div
                    class="col-12 col-lg-6 o_setting_box"
                    id="sale_commitment_date_required"
                >
                    <div class="o_setting_left_pane">
                        <field name="sale_commitment_date_required" />
                    </div>
                    <div class="o_setting_right_pane">
                        <label
                            for="sale_commitment_date_required"
                            string="Require Delivery Date"
                        />
                        <span
                            class="fa fa-lg fa-building-o"
                            title="Values set here are company-specific."
                            aria-label="Values set here are company-specific."
                            groups="base.group_multi_company"
                            role="img"
                        />
                        <div class="text-muted">
                            Sales orders cannot be confirmed without a delivery date
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
