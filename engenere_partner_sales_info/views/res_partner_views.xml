<odoo>
    <record id="view_partner_form_sales_info" model="ir.ui.view">
        <field name="name">res.partner.form.sales.info</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='internal_notes']" position="after">
                <field name="customer_rank" invisible="1" />
                <page
                    name="partner_sales_analysis"
                    string="Sales Analysis"
                    groups="engenere_partner_sales_info.group_partner_sales_analysis"
                    attrs="{'invisible': [('customer_rank','=',0)]}"
                >
                    <group>
                        <group string="Order Information">
                            <field name="last_order_date" />
                            <field name="last_order_status" />
                            <field name="order_count" />
                            <field name="total_ordered" />
                            <field name="average_ordered" />
                            <field name="average_ordered_no_discrepancies" />
                            <field name="average_time_between_orders" />
                            <field name="days_since_last_order" />
                            <field name="last_order_id" />
                        </group>
                        <group string="Quotation Status">
                            <field
                                name="has_open_quotation"
                                string="Pending Quotation?"
                                widget="boolean_checkbox"
                                class="oe_inline"
                            />
                            <field
                                name="last_open_quotation_date"
                                string="Last Quotation Date"
                                attrs="{'invisible': [('has_open_quotation', '=', False)]}"
                            />
                            <field
                                name="last_open_quotation_id"
                                string="Open Quotation"
                                attrs="{'invisible': [('has_open_quotation', '=', False)]}"
                            />
                        </group>
                        <group string="Invoice Information">
                            <field name="last_invoice_date" />
                            <field name="invoice_count" />
                            <field name="total_invoiced" />
                            <field name="average_invoiced" />
                            <field name="average_invoiced_no_discrepancies" />
                            <field name="average_time_between_invoices" />
                            <field name="days_since_last_invoice" />
                            <field name="last_invoice_id" />
                        </group>
                        <div
                            title="analysis-message"
                            class="alert alert-warning"
                            role="alert"
                        >
                            <span
                                class="fa fa-exclamation-circle"
                                style="margin-right: 5px;"
                            />
                            <field name="analysis_message" nolabel="1" />
                        </div>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
