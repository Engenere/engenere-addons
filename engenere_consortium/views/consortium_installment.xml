<odoo>

    <record id="consortium_installment_view_form" model="ir.ui.view">
        <field name="name">consortium.installment.form</field>
        <field name="model">consortium.installment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,open,paid"
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_invoice"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-pencil-square-o"
                            string="Invoice"
                            attrs="{'invisible': [('move_id', '=', False)]}"
                        />
                    </div>
                    <group>
                        <group>
                            <field name="quota_id" readonly="1" />
                            <field name="number" />
                            <field name="due_date" />
                            <field name="is_lance" />
                        </group>
                        <group>
                            <field name="currency_id" invisible="1" />
                            <field name="total_amount" readonly="1" />
                            <field name="state" />
                            <field name="move_id" readonly="1" />
                        </group>
                    </group>
                    <field name="component_ids">
                        <tree editable="bottom">
                            <field name="component_type_id" />
                            <field name="currency_id" invisible="1" />
                            <field name="amount" />
                            <field name="account_id" />
                        </tree>
                    </field>
                    <group>
                        <field name="notes" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="consortium_installment_view_tree" model="ir.ui.view">
        <field name="name">consortium.installment.tree</field>
        <field name="model">consortium.installment</field>
        <field name="arch" type="xml">
            <tree>
                <field name="number" />
                <field name="quota_id" />
                <field name="due_date" />
                <field name="currency_id" invisible="1" />
                <field name="total_amount" />
                <field name="is_lance" />
                <field
                    name="state"
                    widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-warning="state == 'open'"
                    decoration-success="state == 'paid'"
                    decoration-danger="state == 'cancelled'"
                />
                <field name="move_id" optional="show" />
            </tree>
        </field>
    </record>

    <record id="consortium_installment_view_search" model="ir.ui.view">
        <field name="name">consortium.installment.search</field>
        <field name="model">consortium.installment</field>
        <field name="arch" type="xml">
            <search>
                <field name="quota_id" />
                <filter
                    name="draft"
                    string="Draft"
                    domain="[('state', '=', 'draft')]"
                />
                <filter name="open" string="Open" domain="[('state', '=', 'open')]" />
                <filter name="paid" string="Paid" domain="[('state', '=', 'paid')]" />
                <separator />
                <filter
                    name="due_this_month"
                    string="Due This Month"
                    domain="[
                        ('due_date', '&gt;=', (context_today()).strftime('%Y-%m-01')),
                        ('due_date', '&lt;', (context_today() + relativedelta(months=1)).strftime('%Y-%m-01')),
                    ]"
                />
                <filter
                    name="overdue"
                    string="Overdue"
                    domain="[
                        ('due_date', '&lt;', context_today().strftime('%Y-%m-%d')),
                        ('state', 'in', ('draft', 'open')),
                    ]"
                />
                <separator />
                <group expand="0" string="Group By">
                    <filter
                        name="group_by_quota"
                        string="Quota"
                        context="{'group_by': 'quota_id'}"
                    />
                    <filter
                        name="group_by_state"
                        string="State"
                        context="{'group_by': 'state'}"
                    />
                    <filter
                        name="group_by_due_month"
                        string="Due Month"
                        context="{'group_by': 'due_date:month'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="consortium_installment_action" model="ir.actions.act_window">
        <field name="name">Installments</field>
        <field name="res_model">consortium.installment</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
