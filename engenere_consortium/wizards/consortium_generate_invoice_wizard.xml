<odoo>

    <record id="consortium_generate_invoice_wizard_form" model="ir.ui.view">
        <field name="name">consortium.generate.invoice.wizard.form</field>
        <field name="model">consortium.generate.invoice.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Invoices">
                <group>
                    <field name="installment_ids" readonly="1" nolabel="1">
                        <tree>
                            <field name="number" />
                            <field name="quota_id" />
                            <field name="due_date" />
                            <field name="total_amount" />
                        </tree>
                    </field>
                </group>
                <group>
                    <field name="journal_id" />
                    <field name="invoice_date" />
                </group>
                <footer>
                    <button
                        name="action_generate"
                        string="Generate Invoices"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record
        id="action_consortium_generate_invoice_wizard"
        model="ir.actions.act_window"
    >
        <field name="name">Generate Invoices</field>
        <field name="res_model">consortium.generate.invoice.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_consortium_installment" />
    </record>

</odoo>
