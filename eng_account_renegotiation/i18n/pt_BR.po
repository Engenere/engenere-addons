#. module: eng_account_renegotiation
#. odoo-python
#: code:addons/eng_account_renegotiation/models/account_move.py:0
#, python-format
msgid "%(date)s: %(amount)s"
msgstr "%(date)s: %(amount)s"

#. module: eng_account_renegotiation
#. odoo-python
#: code:addons/eng_account_renegotiation/models/account_move.py:0
#, python-format
msgid ""
"<p><strong>Payment Installments Renegotiated</strong></p><p><strong>Previous"
" installments:</strong><br/>%(old)s</p><p><strong>New "
"installments:</strong><br/>%(new)s</p>"
msgstr ""
"<p><strong>Parcelas de Pagamento Renegociadas</strong></p><p><strong>"
"Parcelas anteriores:</strong><br/>%(old)s</p><p><strong>Novas "
"parcelas:</strong><br/>%(new)s</p>"

#. module: eng_account_renegotiation
#: model:ir.module.category,description:eng_account_renegotiation.module_category_installment_renegotiation
msgid "Access rights for renegotiating invoice installments."
msgstr "Direitos de acesso para renegociar parcelas de faturas."

#. module: eng_account_renegotiation
#. odoo-python
#: code:addons/eng_account_renegotiation/wizards/installment_renegotiation_wizard.py:0
#, python-format
msgid "All installment amounts must be greater than zero."
msgstr "Todos os valores de parcela devem ser maiores que zero."

#. module: eng_account_renegotiation
#. odoo-python
#: code:addons/eng_account_renegotiation/wizards/installment_renegotiation_wizard.py:0
#, python-format
msgid "All installments must have a due date."
msgstr "Todas as parcelas devem ter data de vencimento."

#. module: eng_account_renegotiation
#: model:res.groups,comment:eng_account_renegotiation.group_vendor_bill_renegotiation
msgid ""
"Billing users in this group can renegotiate installments of vendor bills\n"
"without Invoicing Manager rights. Customer invoices still require Invoicing\n"
"Manager."
msgstr ""
"Usuários de Faturamento neste grupo podem renegociar parcelas de faturas de\n"
"fornecedor sem direitos de Gerente de Faturamento. Faturas de cliente\n"
"continuam exigindo o Gerente de Faturamento."

#. module: eng_account_renegotiation
#: model:ir.module.category,name:eng_account_renegotiation.module_category_installment_renegotiation
msgid "Installment Renegotiation"
msgstr "Renegociação de Parcelas"

#. module: eng_account_renegotiation
#. odoo-python
#: code:addons/eng_account_renegotiation/models/account_move.py:0
#, python-format
msgid ""
"Only users with 'Billing Administrator' rights or, for vendor bills, Billing"
" users in the 'Renegotiate Vendor Bill Installments' group can renegotiate "
"installments."
msgstr ""
"Somente usuários com direitos de 'Administrador de Faturamento' ou, para "
"faturas de fornecedor, usuários de Faturamento no grupo 'Renegociar Parcelas"
" de Fatura de Fornecedor' podem renegociar parcelas."

#. module: eng_account_renegotiation
#. odoo-python
#: code:addons/eng_account_renegotiation/models/account_move.py:0
#, python-format
msgid "Renegotiate Installments"
msgstr "Renegociar Parcelas"

#. module: eng_account_renegotiation
#: model:res.groups,name:eng_account_renegotiation.group_vendor_bill_renegotiation
msgid "Renegotiate Vendor Bill Installments"
msgstr "Renegociar Parcelas de Fatura de Fornecedor"

#. module: eng_account_renegotiation
#. odoo-python
#: code:addons/eng_account_renegotiation/wizards/installment_renegotiation_wizard.py:0
#, python-format
msgid "The invoice must be posted to renegotiate installments."
msgstr "A fatura deve estar confirmada para renegociar parcelas."

#. module: eng_account_renegotiation
#. odoo-python
#: code:addons/eng_account_renegotiation/wizards/installment_renegotiation_wizard.py:0
#, python-format
msgid ""
"The total amount of installments must remain unchanged. Current difference: "
"%(diff)s"
msgstr ""
"O valor total das parcelas deve permanecer inalterado. Diferença atual: "
"%(diff)s"

#. module: eng_account_renegotiation
#. odoo-python
#: code:addons/eng_account_renegotiation/models/account_move.py:0
#, python-format
msgid ""
"There are no unreconciled payment term lines to renegotiate. All "
"installments have been paid or reconciled."
msgstr ""
"Não há parcelas em aberto para renegociar. Todas as parcelas foram pagas ou "
"reconciliadas."

#. module: eng_account_renegotiation
#. odoo-python
#: code:addons/eng_account_renegotiation/models/account_move.py:0
#, python-format
msgid "You can only renegotiate installments on posted invoices."
msgstr "Só é possível renegociar parcelas de faturas confirmadas."

#. module: eng_account_renegotiation
#. odoo-python
#: code:addons/eng_account_renegotiation/wizards/installment_renegotiation_wizard.py:0
#, python-format
msgid "You must have at least one installment."
msgstr "É necessário ter pelo menos uma parcela."

#. module: eng_account_renegotiation
#: model:ir.model.fields,field_description:eng_account_renegotiation.field_account_installment_renegotiation_wizard__expected_payment_type
msgid "Expected Payment Type"
msgstr "Tipo de Pagamento Esperado"

#. module: eng_account_renegotiation
#: model:ir.model.fields.selection,name:eng_account_renegotiation.selection__account_installment_renegotiation_wizard__expected_payment_type__inbound
msgid "Inbound"
msgstr "Recebimento"

#. module: eng_account_renegotiation
#: model:ir.model,name:eng_account_renegotiation.model_account_installment_renegotiation_wizard
msgid "Installment Renegotiation Wizard"
msgstr "Assistente de Renegociação de Parcelas"

#. module: eng_account_renegotiation
#. odoo-python
#: code:addons/eng_account_renegotiation/wizards/installment_renegotiation_wizard.py:0
#, python-format
msgid ""
"Installments with a partial payment cannot be renegotiated: %(dates)s. "
"Unreconcile the partial payment first."
msgstr ""
"Parcelas com pagamento parcial não podem ser renegociadas: %(dates)s. "
"Desconcilie o pagamento parcial primeiro."

#. module: eng_account_renegotiation
#. odoo-python
#: code:addons/eng_account_renegotiation/wizards/installment_renegotiation_wizard.py:0
#, python-format
msgid "Invoice payment mode replaced during renegotiation: %(old)s → %(new)s"
msgstr "Modo de pagamento da fatura substituído na renegociação: %(old)s → %(new)s"

#. module: eng_account_renegotiation
#: model:ir.model,name:eng_account_renegotiation.model_account_move
msgid "Journal Entry"
msgstr "Lançamento de Diário"

#. module: eng_account_renegotiation
#: model:ir.model.fields,field_description:eng_account_renegotiation.field_account_installment_renegotiation_wizard__header_payment_mode_id
msgid "New Invoice Payment Mode"
msgstr "Novo Modo de Pagamento da Fatura"

#. module: eng_account_renegotiation
#. odoo-python
#: code:addons/eng_account_renegotiation/wizards/installment_renegotiation_wizard.py:0
#, python-format
msgid "(none)"
msgstr "(nenhum)"

#. module: eng_account_renegotiation
#: model:ir.model.fields.selection,name:eng_account_renegotiation.selection__account_installment_renegotiation_wizard__expected_payment_type__outbound
msgid "Outbound"
msgstr "Pagamento"

#. module: eng_account_renegotiation
#: model:ir.model.fields,help:eng_account_renegotiation.field_account_installment_renegotiation_wizard__header_payment_mode_id
msgid ""
"Also replace the payment mode on the invoice header. All new installments "
"will use this mode."
msgstr ""
"Substitui também o modo de pagamento no cabeçalho da fatura. Todas as novas "
"parcelas usarão este modo."

#. module: eng_account_renegotiation
#. odoo-python
#: code:addons/eng_account_renegotiation/wizards/installment_renegotiation_wizard.py:0
#, python-format
msgid ""
"When replacing the invoice payment mode, all installments must use the new "
"mode. Clear the manual modes or the new invoice payment mode."
msgstr ""
"Ao substituir o modo de pagamento da fatura, todas as parcelas devem usar o "
"novo modo. Limpe os modos manuais ou o novo modo de pagamento da fatura."

#. module: eng_account_renegotiation
#. odoo-python
#: code:addons/eng_account_renegotiation/wizards/installment_renegotiation_wizard.py:0
#, python-format
msgid ""
"The new invoice payment mode must be of type %(expected)s for this document."
msgstr ""
"O novo modo de pagamento da fatura deve ser do tipo %(expected)s para este "
"documento."
