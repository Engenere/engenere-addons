#. module: l10n_br_account_renegotiation
#: model_terms:ir.ui.view,arch_db:l10n_br_account_renegotiation.view_installment_renegotiation_wizard_form
msgid ""
"<strong>Note:</strong> This action will modify the payment due dates\n"
"                    and amounts on the posted invoice. The fiscal document (NFe) will\n"
"                    not be affected. A record of this change will be logged in the\n"
"                    invoice's chatter."
msgstr ""
"<strong>Nota:</strong> Esta ação vai alterar as datas de vencimento\n"
"                    e os valores das parcelas da fatura confirmada. O documento fiscal (NF-e)\n"
"                    não será afetado. Um registro desta alteração ficará no chatter\n"
"                    da fatura."

#. module: l10n_br_account_renegotiation
#: model_terms:ir.ui.view,arch_db:l10n_br_account_renegotiation.view_installment_renegotiation_wizard_form
msgid ""
"<strong>Warning:</strong> The total amount must remain unchanged.\n"
"                    Please adjust the installment amounts so the difference is zero."
msgstr ""
"<strong>Atenção:</strong> O valor total deve permanecer inalterado.\n"
"                    Ajuste os valores das parcelas para que a diferença seja zero."

