#. module: l10n_br_account_renegotiation
#: model:ir.model.fields,help:l10n_br_account_renegotiation.field_account_installment_renegotiation_wizard__starting_date
msgid ""
"Base date for computing the new payment term. Leave as the Invoice Date for "
"corrections, or change to today's date for debt renegotiations."
msgstr ""
"Data base para calcular a nova condição de pagamento. Mantenha a Data da "
"Fatura para correções, ou mude para a data de hoje em renegociações de "
"dívida."

