<odoo>

    <record id="view_move_form_renegotiation_vendor_group" model="ir.ui.view">
        <field name="name">account.move.form.renegotiation.vendor.group</field>
        <field name="model">account.move</field>
        <field
            name="inherit_id"
            ref="l10n_br_account_renegotiation.view_move_form_renegotiation"
        />
        <field name="arch" type="xml">
            <!-- Visibility is fully server side via the user-aware
                 can_renegotiate_installments compute -->
            <xpath
                expr="//button[@name='action_renegotiate_installments']"
                position="attributes"
            >
                <attribute name="groups" />
            </xpath>
        </field>
    </record>

</odoo>
