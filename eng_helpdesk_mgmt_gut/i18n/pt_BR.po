#. module: eng_helpdesk_mgmt_gut
#: model:ir.module.module,shortdesc:eng_helpdesk_mgmt_gut.module_meta_information
msgid "Helpdesk GUT Matrix"
msgstr "Matriz GUT para Helpdesk"

#. module: eng_helpdesk_mgmt_gut
#: model:ir.module.module,summary:eng_helpdesk_mgmt_gut.module_meta_information
msgid "Classify helpdesk tickets with the GUT priority matrix (Gravity, Urgency, Tendency)"
msgstr "Classifica chamados do helpdesk com a matriz de priorização GUT (Gravidade, Urgência, Tendência)"

#. module: eng_helpdesk_mgmt_gut
#: model:ir.model,name:eng_helpdesk_mgmt_gut.model_helpdesk_ticket
msgid "Helpdesk Ticket"
msgstr "Chamado de Helpdesk"

#. module: eng_helpdesk_mgmt_gut
#: model:ir.model.fields,field_description:eng_helpdesk_mgmt_gut.field_helpdesk_ticket__gut_gravity
msgid "Gravity (G)"
msgstr "Gravidade (G)"

#. module: eng_helpdesk_mgmt_gut
#: model:ir.model.fields,help:eng_helpdesk_mgmt_gut.field_helpdesk_ticket__gut_gravity
msgid "How serious is the problem: impact if nothing is done."
msgstr "Quão grave é o problema: impacto caso nada seja feito."

#. module: eng_helpdesk_mgmt_gut
#: model:ir.model.fields,field_description:eng_helpdesk_mgmt_gut.field_helpdesk_ticket__gut_urgency
msgid "Urgency (U)"
msgstr "Urgência (U)"

#. module: eng_helpdesk_mgmt_gut
#: model:ir.model.fields,help:eng_helpdesk_mgmt_gut.field_helpdesk_ticket__gut_urgency
msgid "How much time is available before the problem must be solved."
msgstr "Quanto tempo há disponível antes que o problema precise ser resolvido."

#. module: eng_helpdesk_mgmt_gut
#: model:ir.model.fields,field_description:eng_helpdesk_mgmt_gut.field_helpdesk_ticket__gut_tendency
msgid "Tendency (T)"
msgstr "Tendência (T)"

#. module: eng_helpdesk_mgmt_gut
#: model:ir.model.fields,help:eng_helpdesk_mgmt_gut.field_helpdesk_ticket__gut_tendency
msgid "How the problem evolves if nothing is done."
msgstr "Como o problema evolui caso nada seja feito."

#. module: eng_helpdesk_mgmt_gut
#: model:ir.model.fields,field_description:eng_helpdesk_mgmt_gut.field_helpdesk_ticket__gut_score
msgid "GUT Score"
msgstr "Score GUT"

#. module: eng_helpdesk_mgmt_gut
#: model:ir.model.fields,help:eng_helpdesk_mgmt_gut.field_helpdesk_ticket__gut_score
msgid "Product of Gravity × Urgency × Tendency (1-125). Zero when any of the three is not set."
msgstr "Produto de Gravidade × Urgência × Tendência (1-125). Zero quando algum dos três não está preenchido."

#. module: eng_helpdesk_mgmt_gut
#: model:ir.model.fields,field_description:eng_helpdesk_mgmt_gut.field_helpdesk_ticket__gut_band
msgid "GUT Band"
msgstr "Faixa GUT"

#. module: eng_helpdesk_mgmt_gut
#: model:ir.model.fields,help:eng_helpdesk_mgmt_gut.field_helpdesk_ticket__gut_band
msgid "Classification band derived from GUT Score: Unclassified (0), Low (1-15), Medium (16-45), High (46-99), Critical (100-125)."
msgstr "Faixa de classificação derivada do Score GUT: Não classificado (0), Baixa (1-15), Média (16-45), Alta (46-99), Crítica (100-125)."

