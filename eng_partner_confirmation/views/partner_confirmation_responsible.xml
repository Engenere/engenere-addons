<odoo>

    <record model="ir.ui.view" id="partner_confirmation_responsible_tree_view">
        <field name="name">partner.confirmation.responsible.tree</field>
        <field name="model">partner.confirmation.responsible</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name" />
            </tree>
        </field>
    </record>

    <record model="ir.ui.view" id="partner_confirmation_responsible_form_view">
        <field name="name">partner.confirmation.responsible.form</field>
        <field name="model">partner.confirmation.responsible</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_partner_confirmation_responsible">
        <field name="name">Confirmation Responsibles</field>
        <field name="res_model">partner.confirmation.responsible</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="menu_partner_confirmation_responsible"
        name="Responsibles"
        parent="eng_partner_confirmation.menu_partner_confirmation_config"
        action="action_partner_confirmation_responsible"
        sequence="20"
    />

</odoo>
