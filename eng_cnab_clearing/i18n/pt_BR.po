msgstr "a liquidação não tem data de crédito válida"

#. module: eng_cnab_clearing
#. odoo-python
#: code:addons/eng_cnab_clearing/parser/cnab_clearing_parser.py:0
#, python-format
msgid "the occurrence date %(value)s is invalid"
