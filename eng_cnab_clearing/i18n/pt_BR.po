#, python-format
msgid ""
"Record in position %(position)s of the records read from the file, which has"
" no sequence number"
msgstr ""
"Registro na posição %(position)s dos registros lidos do arquivo, que não tem"
" número sequencial"

#. module: eng_cnab_clearing
#. odoo-python
