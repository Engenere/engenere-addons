#. module: eng_cnab_clearing
#. odoo-python
#: code:addons/eng_cnab_clearing/parser/cnab_clearing_parser.py:0
#, python-format
msgid "the occurrence date is zeroed"
msgstr "a data da ocorrência está zerada"
