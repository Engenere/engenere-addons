#: model:ir.model.fields,help:eng_cnab_clearing.field_account_journal__eng_cnab_receipt_method_line_id
msgid ""
"Inbound payment method of this journal whose outstanding receipts account is"
" the clearing account of the bank."
msgstr ""
"Método de recebimento deste diário cuja conta de recebimentos pendentes é a "
"conta transitória do banco."

#. module: eng_cnab_clearing
#: model:ir.model,name:eng_cnab_clearing.model_account_journal
