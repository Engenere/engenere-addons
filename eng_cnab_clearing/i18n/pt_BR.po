#: model:ir.model.fields,help:eng_cnab_clearing.field_account_payment__eng_cnab_credit_date
msgid "Date the bank credits the payment, due date of the clearing line."
msgstr ""
"Data em que o banco credita o pagamento, que é o vencimento da linha da "
"transitória."

#. module: eng_cnab_clearing
#: model:ir.model.fields,help:eng_cnab_clearing.field_account_bank_statement_line__eng_cnab_occurrence_date
#: model:ir.model.fields,help:eng_cnab_clearing.field_account_move__eng_cnab_occurrence_date
#: model:ir.model.fields,help:eng_cnab_clearing.field_account_payment__eng_cnab_occurrence_date
msgid ""
"Date the customer paid, which the clearing entry must keep as its accounting"
" date."
msgstr ""
"Data em que o cliente pagou, que o lançamento na transitória deve manter "
"como data contábil."

#. module: eng_cnab_clearing
#: model:ir.model.fields,field_description:eng_cnab_clearing.field_l10n_br_cnab_return_log__eng_file_hash
